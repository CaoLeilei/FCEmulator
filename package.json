{
  "name": "fc-emulator",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "description": "FC/NES 模拟器 - 基于 TypeScript 的浏览器模拟器",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:apu": "tsx test/apu/index.ts",
    "test:ppu": "tsx test/ppu/index.ts"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "keywords": [
    "emulator",
    "nes",
    "fc",
    "retro",
    "gaming",
    "typescript",
    "web"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "raf": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@types/raf": "^3.4.3",
    "terser": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^5.0.0"
  }
}